# PQ2_0 = 7.21 GB, best on 12 GB+ (and on H100/A100/Blackwell).
# PTQ1_0 = 5.95 GB, use on 8 GB cards and Ada/L4.
MODEL_FILE=Ternary-Bonsai-2-27B-PQ2_0.gguf

# Vision tower (+0.63 GB). 0 = text only.
ENABLE_VISION=1

# 8 GB -> 16384 | 12 GB -> 57344 | 16 GB+ -> 131072 (max 262144)
CTX_SIZE=32768

N_GPU_LAYERS=99
FLASH_ATTN=on

# Thinking preset: --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.05
# Instruct preset: --temp 0.7 --top-p 0.80 --top-k 20
# Default reasoning effort is xhigh; --chat-template-kwargs '{"reasoning_effort":"medium"}' for shorter.
EXTRA_ARGS=--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.05

# Retries per file before giving up (each resumes, it never restarts from 0).
DOWNLOAD_ATTEMPTS=20

# Optional: only raises HF rate limits, not required for this public repo.
# HF_TOKEN=

# --- Web tools (MCP) --------------------------------------------------------
# 1 exposes web_search / web_fetch to the model. Enabling tools also makes
# llama-server default --cors-origins to localhost.
MCP_ENABLE=0

# Empty = DuckDuckGo lite endpoint, no key and no account. Point at your own
# SearXNG to keep queries on your network (needs `json` in its search.formats).
SEARXNG_URL=
SEARCH_RESULTS=8
FETCH_MAX_CHARS=20000
HTTP_TIMEOUT=20
